{
  "name": "snap",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/main.ts",
    "build": "tsc --noEmit",
    "build:test": "tsc --noEmit -p tsconfig.test.json",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "check": "npm run build && npm run build:test && npm run lint",
    "test:unit": "tsx --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.18.0",
    "eslint": "^10.10.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.69.0"
  }
}
